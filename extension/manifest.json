{
  "manifest_version": 3,
  "name": "CardComp: Find the Best Pakistani Card For You",
  "version": "0.2.0",
  "key": "",
  "description": "Compare Pakistani bank card discounts: discount %, caps, valid days and annual fees. Unofficial.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://peekaboo.guru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CardComp",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
